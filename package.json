{
  "name": "craftaib",
  "private": true,
  "version": "0.1.0",
  "description": "Unified Minecraft image, voxel, map-art, schematic, and scene engine.",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "bootstrap": "pnpm install --recursive",
    "build:craftmatic": "pnpm --dir vendor/craftmatic build",
    "build:cartographer": "pnpm --dir vendor/cartographer build",
    "build:core": "node scripts/build-engine.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "typecheck:engine": "node scripts/build-engine.mjs --check",
    "test:engine": "node scripts/build-engine.mjs && npm run build:browser-worker && node scripts/engine-smoke.mjs && node scripts/vision-contract-smoke.mjs && node scripts/autonomous-planner-smoke.mjs && node scripts/worker-smoke.mjs && node scripts/generate-fixtures.mjs && node scripts/generate-grid-fixture.mjs && node scripts/fixture-smoke.mjs && node scripts/litematica-smoke.mjs && node scripts/cli-smoke.mjs",
    "build": "node scripts/build-engine.mjs",
    "dev:craftmatic": "pnpm --dir vendor/craftmatic dev:web",
    "dev:cartographer": "pnpm --dir vendor/cartographer watch",
    "prestart": "npm run build:engine && npm run build:browser-worker && npm run stage:browser-worker && npm run build:ui",
    "start": "node scripts/server.mjs",
    "start:detached": "node scripts/start-server-detached.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --config vite.config.ts",
    "build:ui": "vite build --config vite.config.ts",
    "typecheck:ui": "tsc -p frontend/tsconfig.json --noEmit",
    "stage:browser-worker": "node scripts/stage-browser-worker.mjs",
    "matrix": "node scripts/show-matrix.mjs",
    "test:ui": "node scripts/architect-ui-smoke.mjs",
    "fixtures:generate": "node scripts/build-engine.mjs && node scripts/generate-fixtures.mjs && node scripts/generate-grid-fixture.mjs",
    "test:cli": "node scripts/build-engine.mjs && node scripts/cli-smoke.mjs",
    "test:all": "npm run test:engine && npm run test:waxmapart && npm run test:server && npm run typecheck:ui",
    "test:server": "node scripts/server-smoke.mjs",
    "test:waxmapart": "node scripts/build-engine.mjs && node scripts/waxmapart-smoke.mjs",
    "build:browser-worker": "pwsh -NoProfile -File scripts/build-browser-worker.ps1",
    "test:browser-ai": "node scripts/ai-generation-browser-smoke.mjs",
    "test:ai-ui": "node scripts/ai-generation-browser-smoke.mjs",
    "test:architect-ui": "node scripts/architect-ui-smoke.mjs",
    "test:vision-live": "node scripts/build-engine.mjs && node scripts/vision-live-smoke.mjs",
    "test:viewer-regions": "node scripts/viewer-region-browser-smoke.mjs",
    "test:buttons": "node scripts/ui-button-smoke.mjs",
    "test:file-actions": "node scripts/ui-file-action-smoke.mjs",
    "setup:browser": "playwright-core install chromium --only-shell",
    "test:browser": "node scripts/browser-suite.mjs",
    "verify": "npm run test:all && npm run build:ui && npm run test:browser"
  },
  "devDependencies": {
    "@mattzh72/lodestone": "0.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "dependencies": {
    "lucide-react": "0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "three": "0.172.0"
  }
}
